# ==============================================================================
# CONFIGURATION DE PRODUCTION - GUIDE DU POTAGER TROPICAL
# ==============================================================================
# Copiez ce fichier vers .env sur votre serveur de production et complétez les valeurs réelles :
#   cp .env.production.example .env

# --- SÉCURITÉ DJANGO CORE ---
DEBUG=False
SECRET_KEY=change_me_to_a_secure_random_string_of_at_least_50_chars
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=api.guidedupotager.com,guidedupotager.onrender.com,127.0.0.1,localhost

# --- BASE DE DONNÉES POSTGRESQL ---
POSTGRES_DB=guide_potager_prod
POSTGRES_USER=potager_prod_user
POSTGRES_PASSWORD=ChangerCeMotDePasseTresSecurise2026!
DATABASE_URL=postgres://potager_prod_user:ChangerCeMotDePasseTresSecurise2026!@db:5432/guide_potager_prod

# --- SÉCURITÉ HTTPS & CORS ---
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CORS_ALLOWED_ORIGINS=https://guidedupotager.com,https://api.guidedupotager.com

# --- PASSERELLE DE PAIEMENT CHARIOW (LIVE) ---
CHARIOW_API_KEY=chariow_live_sk_xxxxxxxxxxxxxxxxxxxx
CHARIOW_WEBHOOK_SECRET=chariow_whsec_xxxxxxxxxxxxxxxxxxxx
CHARIOW_BASE_URL=https://api.chariow.com/v1
CHARIOW_PRODUCT_MONTHLY_ID=prd_monthly_live_id
CHARIOW_PRODUCT_SEASONAL_ID=prd_seasonal_live_id
CHARIOW_PRODUCT_YEARLY_ID=prd_yearly_live_id

# --- ENVOI D'EMAILS TRANSAC ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.votre_cle_api_sendgrid
DEFAULT_FROM_EMAIL=Guide du Potager <support@guidedupotager.com>

# --- STOCKAGE MÉDIAS CLOUD (OPTIONNEL SI CLOUDINARY) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
