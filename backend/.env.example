# Configuration Générale
SECRET_KEY=django-insecure-guide-du-potager-super-secret-key-2026
DEBUG=True

# Chariow API Configuration
# Obtenez votre clé API dans votre compte Chariow : Paramètres > Clés API
CHARIOW_API_KEY=your_chariow_api_key_here

# Obtenez votre secret de webhook dans Automation > Pulses > Détails du Pulse
CHARIOW_WEBHOOK_SECRET=your_chariow_webhook_secret_here

# URL de base de l'API Chariow (par défaut: https://api.chariow.com/v1)
CHARIOW_BASE_URL=https://api.chariow.com/v1

# Identifiants des produits créés sur votre boutique Chariow
CHARIOW_PRODUCT_MONTHLY_ID=prd_monthly_example_id
CHARIOW_PRODUCT_YEARLY_ID=prd_yearly_example_id
